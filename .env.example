# Domolov configuration. Copy to .env; Docker Compose reads it automatically.
# Empty values mean "unset". Compose passes every variable below to the api, worker
# and migrate containers (DOMOLOV_API_UPSTREAM only to web).

# --- Database -------------------------------------------------------------------
# Compose builds the connection string from POSTGRES_PASSWORD. Set ConnectionStrings__Default
# only when running outside Compose (dotnet run) or against an external PostgreSQL.
POSTGRES_PASSWORD=domolov
# ConnectionStrings__Default=Host=localhost;Port=5432;Database=domolov;Username=domolov;Password=domolov

# --- Process role ---------------------------------------------------------------
# api = HTTP API only; worker = scheduler, Playwright scans and cleanup (still serves /health/*);
# all = both in one process (local `dotnet run`). "web" is a deprecated alias for api.
# Compose and Kubernetes set this per service; only needed when running the host directly.
# DOMOLOV_ROLE=all

# --- Admin sign-in --------------------------------------------------------------
# Plain password, or a hash from `dotnet Domolov.Api.dll hash-password <password>`
# (docker compose run --rm api hash-password '<password>'). The hash wins if both are set.
DOMOLOV_ADMIN_PASSWORD=changeme
# DOMOLOV_ADMIN_PASSWORD_HASH=
# Days a sign-in stays valid without activity (sliding).
# DOMOLOV_SESSION_LIFETIME_DAYS=14
# Public URL of the web app (e.g. https://domolov.example.com). Adds "Open in Domolov" links
# to notifications. Empty = links point at the listing only.
# DOMOLOV_PUBLIC_URL=

# --- Scheduling and scanning (worker) -------------------------------------------
# IANA timezone for Watch cron schedules.
DOMOLOV_TIMEZONE=Europe/Ljubljana
# Parallel Playwright ScanRuns.
DOMOLOV_MAX_CONCURRENT_SCANS=1
# Pause after each ScanRun before the next may start (Cloudflare pacing).
DOMOLOV_SCAN_COOLDOWN_MS=20000
# Max wait for a CloudflareChallenge to clear before it counts as a CloudflareBlock.
DOMOLOV_CLOUDFLARE_CHALLENGE_WAIT_MS=30000
# true = Chromium new headless mode (prod worker image). false = headed; needs Xvfb,
# i.e. the dev worker from docker-compose.dev.yml (the prod image refuses to start headed).
DOMOLOV_BROWSER_HEADLESS=true
# Persistent Chromium profile. Compose and Kubernetes pin it to /data/browser-profile.
# DOMOLOV_BROWSER_USER_DATA_DIR=/data/browser-profile
# true replaces nepremicnine.net with canned listings. Smoke tests and demo screenshots only.
DOMOLOV_FAKE_PROVIDER=false

# --- Listing matching -----------------------------------------------------------
# Match score thresholds (0-1): at or above AUTO_LINK listings are linked automatically;
# at or above POSSIBLE they are offered as a possible match.
DOMOLOV_MATCH_AUTO_LINK_SCORE=0.85
DOMOLOV_MATCH_POSSIBLE_SCORE=0.6

# --- Retention (cleanup job, worker) ----------------------------------------------
# Days to keep delisted listings.
DOMOLOV_RETENTION_DELISTED_DAYS=30
# Days to keep listings no Watch references any more.
DOMOLOV_RETENTION_ORPHAN_LISTING_DAYS=30
# ScanRun history: delete runs older than N days, but always keep the newest K per Watch.
DOMOLOV_RETENTION_SCAN_RUN_DAYS=90
DOMOLOV_RETENTION_SCAN_RUN_KEEP_PER_WATCH=20
# Days to keep scan artifacts.
DOMOLOV_RETENTION_ARTIFACT_DAYS=14
# Days to keep sign-in sessions.
DOMOLOV_RETENTION_SESSION_DAYS=30
# Local time (HH:mm, DOMOLOV_TIMEZONE) of the daily cleanup; a random 0-30 min delay is added.
DOMOLOV_RETENTION_DAILY_AT=04:00

# --- Logging and telemetry ------------------------------------------------------
# Serilog minimum level: Verbose, Debug, Information, Warning, Error, Fatal.
DOMOLOV_LOG_LEVEL=Information
# Optional extra log file path inside the container. Empty = stdout only (recommended in containers).
# DOMOLOV_LOG_FILE=
# OTLP endpoint for traces and metrics. Empty = telemetry export off.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Notifications (all optional) -----------------------------------------------
# Discord webhooks are configured per Watch in the UI, not here.
# DOMOLOV_TELEGRAM_BOT_TOKEN=
# DOMOLOV_SMTP_HOST=
# DOMOLOV_SMTP_PORT=587
# DOMOLOV_SMTP_USER=
# DOMOLOV_SMTP_PASSWORD=
# DOMOLOV_SMTP_FROM=
# Web Push (VAPID) key pair, e.g. from `npx web-push generate-vapid-keys`.
# DOMOLOV_VAPID_PUBLIC_KEY=
# DOMOLOV_VAPID_PRIVATE_KEY=
# DOMOLOV_VAPID_SUBJECT=mailto:admin@localhost

# --- Web container (SPA + reverse proxy) -----------------------------------------
# Where nginx proxies /api and /health: scheme://host:port, no trailing slash or path.
# DOMOLOV_API_UPSTREAM=http://api:8080
