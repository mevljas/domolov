@using Domolov.Application.Contracts
@using Domolov.Domain.Services
@inject IStringLocalizer<SharedResources> L

<MudCard Class="listing-summary-card" Elevation="0" Outlined="true">
    @if (!string.IsNullOrEmpty(Item.ImageUrl))
    {
        <MudCardMedia Image="@Item.ImageUrl" Height="160" Style="object-fit: cover;" />
    }
    <MudCardContent>
        @if (!string.IsNullOrWhiteSpace(TypeRoomsLine))
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@TypeRoomsLine</MudText>
        }
        <MudText Typo="Typo.h6" Class="listing-summary-card__location">
            <MudLink Href="@($"listings/{Item.Id}")" Color="Color.Primary">@(Item.Location ?? Item.Title)</MudLink>
        </MudText>
        @if (!string.IsNullOrWhiteSpace(ShortDescription))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@ShortDescription</MudText>
        }
        @if (AttributeParts.Count > 0)
        {
            <MudText Typo="Typo.caption" Class="mt-1">@string.Join(" · ", AttributeParts)</MudText>
        }
        @if (Item.LatestPrice is decimal price)
        {
            <MudText Typo="Typo.h6" Class="listing-summary-card__price mt-2">
                @PriceFormatting.Format(price, Item.Currency)
            </MudText>
            @if (Item.PreviousPrice is decimal prev && prev > price)
            {
                <MudText Typo="Typo.caption" Class="listing-summary-card__drop">
                    @string.Format(L["PriceDropFrom"], PriceFormatting.Format(prev, Item.Currency))
                </MudText>
            }
        }
    </MudCardContent>
    <MudCardActions>
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="OnToggleBookmark">
            @(Item.IsBookmarked ? L["Unbookmark"] : L["Bookmark"])
        </MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Href="@Item.Url" Target="_blank">
            @L["OpenOriginal"]
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public ListingResponse Item { get; set; } = null!;

    [Parameter]
    public EventCallback OnToggleBookmark { get; set; }

    private string? TypeRoomsLine
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(Item.PropertyType) && !string.IsNullOrWhiteSpace(Item.Rooms))
            {
                return $"{Item.PropertyType}, {Item.Rooms}";
            }

            return Item.PropertyType ?? Item.Rooms;
        }
    }

    private string? ShortDescription
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Item.Description))
            {
                return null;
            }

            var text = Item.Description.Trim();
            const int max = 110;
            return text.Length <= max ? text : text[..(max - 1)].TrimEnd() + "…";
        }
    }

    private IReadOnlyList<string> AttributeParts
    {
        get
        {
            var parts = new List<string>(4);
            if (!string.IsNullOrWhiteSpace(Item.SizeText))
            {
                parts.Add(Item.SizeText);
            }

            if (!string.IsNullOrWhiteSpace(Item.YearText))
            {
                parts.Add(Item.YearText);
            }

            if (!string.IsNullOrWhiteSpace(Item.FloorText))
            {
                parts.Add(Item.FloorText);
            }

            if (!string.IsNullOrWhiteSpace(Item.LandSizeText))
            {
                parts.Add(Item.LandSizeText);
            }

            return parts;
        }
    }
}
