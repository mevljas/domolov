@page "/listings/{Id:guid}"
@rendermode InteractiveServer
@using Domolov.Application.Contracts
@using Domolov.Application.Services
@using Domolov.Domain.Services
@inject IListingQueryService Listings
@inject IJSRuntime Js
@inject IStringLocalizer<SharedResources> L
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@(_detail?.Title ?? L["Listing"])</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-6" />
}
else if (_detail is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@L["ListingNotFound"]</MudAlert>
    <MudButton Href="listings" Variant="Variant.Text" Color="Color.Primary" Class="mt-2">@L["NavListings"]</MudButton>
}
else
{
    <article class="listing-detail domolov-feed-enter">
        @if (!string.IsNullOrWhiteSpace(TypeRoomsLine))
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1">@TypeRoomsLine</MudText>
        }
        <MudText Typo="Typo.h1">@(_detail.Location ?? _detail.Title)</MudText>
        @if (!string.IsNullOrWhiteSpace(_detail.Location) &&
             !string.Equals(_detail.Location, _detail.Title, StringComparison.Ordinal))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@_detail.Title</MudText>
        }
        @if (LatestPrice is decimal price)
        {
            <MudText Typo="Typo.h4" Class="listing-detail__price">@PriceFormatting.Format(price, LatestCurrency)</MudText>
        }
        @if (AttributeParts.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="listing-detail__attrs mud-text-secondary">@string.Join(" · ", AttributeParts)</MudText>
        }
        @if (!string.IsNullOrEmpty(_detail.ImageUrl))
        {
            <img class="listing-detail__image" src="@_detail.ImageUrl" alt="" />
        }
        @if (!string.IsNullOrWhiteSpace(_detail.Description))
        {
            <MudText Typo="Typo.body1" Class="listing-detail__desc">@_detail.Description</MudText>
        }
        <MudStack Row="true" Spacing="2" Class="mt-3" Wrap="Wrap.Wrap">
            <MudButton Href="@_detail.Url" Target="_blank" Variant="Variant.Outlined" Color="Color.Primary">
                @L["OpenOriginal"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ToggleBookmarkAsync">
                @(_detail.IsBookmarked ? L["Unbookmark"] : L["Bookmark"])
            </MudButton>
        </MudStack>

        <MudText Typo="Typo.h2" Class="mt-6 mb-3">@L["PriceHistory"]</MudText>
        @if (_detail.Prices.Count == 0)
        {
            <MudText Class="mud-text-secondary">—</MudText>
        }
        else
        {
            <canvas id="priceChart" width="600" height="280" class="listing-detail__chart"></canvas>
        }
    </article>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ListingDetailResponse? _detail;
    private bool _loading = true;
    private bool _chartRendered;

    private decimal? LatestPrice =>
        _detail?.Prices.Count > 0 ? _detail.Prices[^1].Amount : null;

    private string LatestCurrency =>
        _detail?.Prices.Count > 0 ? _detail.Prices[^1].Currency : "EUR";

    private string? TypeRoomsLine
    {
        get
        {
            if (_detail is null)
            {
                return null;
            }

            if (!string.IsNullOrWhiteSpace(_detail.PropertyType) && !string.IsNullOrWhiteSpace(_detail.Rooms))
            {
                return $"{_detail.PropertyType}, {_detail.Rooms}";
            }

            return _detail.PropertyType ?? _detail.Rooms;
        }
    }

    private IReadOnlyList<string> AttributeParts
    {
        get
        {
            if (_detail is null)
            {
                return [];
            }

            var parts = new List<string>(4);
            if (!string.IsNullOrWhiteSpace(_detail.SizeText))
            {
                parts.Add(_detail.SizeText);
            }

            if (!string.IsNullOrWhiteSpace(_detail.YearText))
            {
                parts.Add(_detail.YearText);
            }

            if (!string.IsNullOrWhiteSpace(_detail.FloorText))
            {
                parts.Add(_detail.FloorText);
            }

            if (!string.IsNullOrWhiteSpace(_detail.LandSizeText))
            {
                parts.Add(_detail.LandSizeText);
            }

            return parts;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _detail = await Listings.GetDetailAsync(Id);
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_chartRendered && _detail is not null && _detail.Prices.Count > 0)
        {
            _chartRendered = true;
            var labels = _detail.Prices.Select(p => p.ObservedAt.ToString("u")).ToArray();
            var values = _detail.Prices.Select(p => (double)p.Amount).ToArray();
            await Js.InvokeVoidAsync("domolov.renderPriceChart", "priceChart", labels, values);
        }
    }

    private async Task ToggleBookmarkAsync()
    {
        if (_detail is null)
        {
            return;
        }

        var next = !_detail.IsBookmarked;
        await Listings.SetBookmarkAsync(_detail.Id, next);
        Snackbar.Add(next ? L["Bookmark"] : L["Unbookmark"], Severity.Success);
        _detail = await Listings.GetDetailAsync(Id);
    }
}
