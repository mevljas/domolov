@page "/bookmarks"
@rendermode InteractiveServer
@using Domolov.Application.Contracts
@using Domolov.Application.Services
@using Domolov.Components.Listings
@inject IListingQueryService Listings
@inject IStringLocalizer<SharedResources> L
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["NavBookmarks"]</PageTitle>

<h1>@L["NavBookmarks"]</h1>

@if (_items is null)
{
    <p>@L["Loading"]</p>
}
else if (_items.Count == 0)
{
    <p>@L["NoBookmarks"]</p>
}
else
{
    <div class="row g-3">
        @foreach (var item in _items)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <ListingSummaryCard Item="item" OnToggleBookmark="() => ToggleBookmarkAsync(item)" />
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ListingResponse>? _items;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _items = await Listings.GetForWatchAsync(null, true);
    }

    private async Task ToggleBookmarkAsync(ListingResponse item)
    {
        await Listings.SetBookmarkAsync(item.Id, !item.IsBookmarked);
        await ReloadAsync();
    }
}
