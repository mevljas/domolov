@page "/login"
@layout LoginLayout
@using Domolov
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Navigation

<PageTitle>@L["Login"] — @L["AppName"]</PageTitle>

<div class="login-hero">
    <div class="login-hero__panel">
        <h1 class="login-hero__brand">@L["AppName"]</h1>
        <p class="login-hero__tagline">@L["HomeIntro"]</p>
        <p class="login-hero__self-link"><a href="login">@L["Login"]</a></p>

        @if (ShowError)
        {
            <p class="text-danger login-hero__error">@L["LoginFailed"]</p>
        }

        <form method="post" action="/auth/login" data-enhance="false">
            <AntiforgeryToken />
            <div>
                <label for="password">@L["Password"]</label>
                <input
                    id="password"
                    name="password"
                    type="password"
                    required
                    autocomplete="current-password"
                />
            </div>
            <button class="login-hero__submit" type="submit">@L["SignIn"]</button>
        </form>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public bool ShowError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var state = await AuthenticationStateTask;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
    }
}
