@page "/login"
@using Domolov
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Navigation

<PageTitle>@L["Login"]</PageTitle>

<h1>@L["Login"]</h1>

@if (ShowError)
{
    <p class="text-danger">@L["LoginFailed"]</p>
}

<form method="post" action="/auth/login" data-enhance="false">
    <AntiforgeryToken />
    <div class="mb-3">
        <label class="form-label" for="password">@L["Password"]</label>
        <input
            id="password"
            name="password"
            type="password"
            class="form-control"
            required
            autocomplete="current-password"
        />
    </div>
    <button class="btn btn-primary" type="submit">@L["SignIn"]</button>
</form>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public bool ShowError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var state = await AuthenticationStateTask;
        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
    }
}
