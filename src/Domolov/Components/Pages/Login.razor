@page "/login"
@using Domolov
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Login"]</PageTitle>

<h1>@L["Login"]</h1>

@if (ShowError)
{
    <p class="text-danger">@L["LoginFailed"]</p>
}

<form method="post" action="/auth/login" data-enhance="false">
    <AntiforgeryToken />
    <div class="mb-3">
        <label class="form-label" for="password">@L["Password"]</label>
        <input
            id="password"
            name="password"
            type="password"
            class="form-control"
            required
            autocomplete="current-password"
        />
    </div>
    <button class="btn btn-primary" type="submit">@L["SignIn"]</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public bool ShowError { get; set; }
}
