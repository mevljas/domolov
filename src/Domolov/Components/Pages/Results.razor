@page "/results"
@rendermode InteractiveServer
@using Domolov.Components.Listings
@using Domolov.Application.Contracts
@using Domolov.Application.Services
@inject IListingQueryService Listings
@inject IWatchService Watches
@inject IStringLocalizer<SharedResources> L
@inject IJSRuntime Js
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["NavResults"]</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="mb-0">@L["NavResults"]</h1>
    <button
        class="btn btn-outline-danger"
        type="button"
        disabled="@(_busy || _items is null || _items.Count == 0)"
        @onclick="DeleteAllAsync"
    >
        @L["DeleteAllResults"]
    </button>
</div>

<div class="mb-3">
    <label>@L["FilterWatch"]</label>
    <select class="form-select" @bind="_watchIdText" @bind:after="ReloadAsync">
        <option value="">@L["AllWatches"]</option>
        @if (_watches is not null)
        {
            @foreach (var w in _watches)
            {
                <option value="@w.Id">@w.Name</option>
            }
        }
    </select>
</div>

@if (_items is null)
{
    <p>@L["Loading"]</p>
}
else if (_items.Count == 0)
{
    <p class="text-muted">@L["NoResults"]</p>
}
else
{
    <div class="row g-3">
        @foreach (var item in _items)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <ListingSummaryCard Item="item" OnToggleBookmark="() => ToggleBookmarkAsync(item)" />
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ListingResponse>? _items;
    private IReadOnlyList<WatchResponse>? _watches;
    private string _watchIdText = "";
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _watches = await Watches.GetAllAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        Guid? watchId = Guid.TryParse(_watchIdText, out var id) ? id : null;
        _items = await Listings.GetForWatchAsync(watchId, false);
    }

    private async Task ToggleBookmarkAsync(ListingResponse item)
    {
        await Listings.SetBookmarkAsync(item.Id, !item.IsBookmarked);
        await ReloadAsync();
    }

    private async Task DeleteAllAsync()
    {
        if (_busy)
        {
            return;
        }

        var confirmed = await Js.InvokeAsync<bool>("confirm", L["DeleteAllResultsConfirm"].Value);
        if (!confirmed)
        {
            return;
        }

        _busy = true;
        try
        {
            await Listings.DeleteAllAsync();
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
