@page "/settings"
@rendermode InteractiveServer
@using Domolov.Application.Services
@inject ISettingsService SettingsService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["NavSettings"]</PageTitle>

<h1>@L["NavSettings"]</h1>

@{
    var s = SettingsService.GetSettings();
}

<dl>
    <dt>@L["TimeZone"]</dt><dd>@s.TimeZone</dd>
    <dt>@L["MaxConcurrentScans"]</dt><dd>@s.MaxConcurrentScans</dd>
    <dt>@L["BrowserHeadless"]</dt><dd>@s.BrowserHeadless</dd>
    <dt>@L["Role"]</dt><dd>@s.Role</dd>
    <dt>Telegram</dt><dd>@(s.TelegramConfigured ? L["Configured"] : L["NotConfigured"])</dd>
    <dt>SMTP</dt><dd>@(s.SmtpConfigured ? L["Configured"] : L["NotConfigured"])</dd>
    <dt>Web Push</dt><dd>@(s.VapidConfigured ? L["Configured"] : L["NotConfigured"])</dd>
</dl>

<h2>@L["Language"]</h2>
<button class="btn btn-outline-primary" @onclick='() => SetCulture("sl-SI")'>Slovenščina</button>
<button class="btn btn-outline-primary" @onclick='() => SetCulture("en")'>English</button>

@code {
    private async Task SetCulture(string culture)
    {
        using var client = new HttpClient { BaseAddress = new Uri(Nav.BaseUri) };
        await client.PostAsync($"/api/culture?culture={Uri.EscapeDataString(culture)}", null);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
