@page "/settings"
@rendermode InteractiveServer
@using Domolov.Application.Services
@inject ISettingsService SettingsService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["NavSettings"]</PageTitle>

@{
    var s = SettingsService.GetSettings();
}

<MudStack Spacing="4">
    <MudText Typo="Typo.h1">@L["NavSettings"]</MudText>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudSimpleTable Dense="true" Style="background: transparent">
            <tbody>
                <tr><td>@L["TimeZone"]</td><td>@s.TimeZone</td></tr>
                <tr><td>@L["MaxConcurrentScans"]</td><td>@s.MaxConcurrentScans</td></tr>
                <tr><td>@L["ScanCooldownMs"]</td><td>@s.ScanCooldownMs</td></tr>
                <tr><td>@L["CloudflareChallengeWaitMs"]</td><td>@s.CloudflareChallengeWaitMs</td></tr>
                <tr><td>@L["BrowserHeadless"]</td><td>@s.BrowserHeadless</td></tr>
                <tr><td>@L["Role"]</td><td>@s.Role</td></tr>
                <tr><td>Telegram</td><td>@(s.TelegramConfigured ? L["Configured"] : L["NotConfigured"])</td></tr>
                <tr><td>SMTP</td><td>@(s.SmtpConfigured ? L["Configured"] : L["NotConfigured"])</td></tr>
                <tr><td>Web Push</td><td>@(s.VapidConfigured ? L["Configured"] : L["NotConfigured"])</td></tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-3">@L["Language"]</MudText>
        <MudStack Row="true" Spacing="2">
            <form method="post" action="@CultureAction("sl-SI")" data-enhance="false">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">
                    Slovenščina
                </MudButton>
            </form>
            <form method="post" action="@CultureAction("en")" data-enhance="false">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">
                    English
                </MudButton>
            </form>
        </MudStack>
    </MudPaper>
</MudStack>

@code {
    private string CultureAction(string culture) =>
        $"/api/culture?culture={Uri.EscapeDataString(culture)}&returnUrl={Uri.EscapeDataString("/settings")}";
}
