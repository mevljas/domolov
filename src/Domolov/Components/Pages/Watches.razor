@page "/watches"
@rendermode InteractiveServer
@using Domolov.Application.Abstractions
@using Domolov.Application.Contracts
@using Domolov.Application.Services
@using Domolov.Domain.Enums
@using Domolov.Domain.Services
@using Microsoft.Extensions.Options
@implements IAsyncDisposable
@inject IWatchService WatchService
@inject IScanOrchestrator Orchestrator
@inject IScanRunQueryService ScanQuery
@inject IOptions<DomolovOptions> Options
@inject IStringLocalizer<SharedResources> L
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["NavWatches"]</PageTitle>

<MudStack Spacing="4">
    <MudText Typo="Typo.h1">@L["NavWatches"]</MudText>

    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-3">@L["CreateWatch"]</MudText>
        <EditForm Model="_create" OnValidSubmit="CreateAsync">
            <DataAnnotationsValidator />
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_create.Name" Label="@L["Name"]" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_create.SearchUrl" Label="@L["SearchUrl"]" Variant="Variant.Outlined" />
                <WatchScheduleEditor @bind-Cron="_create.Cron" TimeZoneId="@TimeZoneId" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">
                    @L["Save"]
                </MudButton>
            </MudStack>
        </EditForm>
    </MudPaper>

    @if (_watches is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_watches.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["NoWatches"] @L["NavWatches"]</MudAlert>
    }
    else
    {
        <MudExpansionPanels MultiExpansion="true" Class="domolov-feed-enter">
            @foreach (var w in _watches)
            {
                <MudExpansionPanel>
                    <TitleContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h6">@w.Name</MudText>
                            @if (_active.ContainsKey(w.Id))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Info">@FormatActiveStatus(_active[w.Id])</MudChip>
                            }
                            @if (IsCloudflareCoolingDown(w))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["CloudflareBadge"]</MudChip>
                            }
                        </MudStack>
                    </TitleContent>
                    <ChildContent>
                        <MudStack Spacing="3">
                            <MudLink Href="@w.SearchUrl" Target="_blank">@w.SearchUrl</MudLink>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @L["Schedule"]: @SummarizeSchedule(w.Cron) · @L["Baseline"]: @(w.HasCompletedBaseline ? L["Yes"] : L["No"])
                            </MudText>
                            @if (IsCloudflareCoolingDown(w))
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true">
                                    @string.Format(L["CloudflareBlockedUntil"], w.CloudflareBlockedUntil)
                                </MudAlert>
                            }
                            else if (w.CloudflareStrikeCount > 0)
                            {
                                <MudText Typo="Typo.caption">@string.Format(L["CloudflareStrikes"], w.CloudflareStrikeCount)</MudText>
                            }

                            <MudPaper Class="pa-3" Elevation="0" Style="background: var(--domolov-sage)">
                                <WatchScheduleEditor
                                    Cron="@GetEditCron(w.Id, w.Cron)"
                                    CronChanged="cron => OnEditCronChanged(w.Id, cron)"
                                    TimeZoneId="@TimeZoneId" />
                                <MudButton Class="mt-2" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                           OnClick="() => SaveScheduleAsync(w)">
                                    @L["SaveSchedule"]
                                </MudButton>
                            </MudPaper>

                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@_active.ContainsKey(w.Id)"
                                           OnClick="() => RunAsync(w.Id)">
                                    @L["RunNow"]
                                </MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => DeleteAsync(w.Id)">
                                    @L["Delete"]
                                </MudButton>
                            </MudStack>

                            <MudText Typo="Typo.subtitle1">@L["NotificationRoutes"]</MudText>
                            @if (w.Routes.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                            }
                            else
                            {
                                <MudStack Spacing="1">
                                    @foreach (var r in w.Routes)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                            <MudText Typo="Typo.body2">@r.Channel → @r.Destination (@r.Triggers)</MudText>
                                            <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           OnClick="() => DeleteRouteAsync(w.Id, r.Id)" />
                                        </MudStack>
                                    }
                                </MudStack>
                            }

                            @{
                                var routeForm = GetRouteForm(w.Id);
                            }
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                                <MudSelect T="NotificationChannel" @bind-Value="routeForm.Channel" Label="Channel" Style="min-width: 10rem">
                                    @foreach (var c in Enum.GetValues<NotificationChannel>())
                                    {
                                        <MudSelectItem Value="@c">@c</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudTextField @bind-Value="routeForm.Destination" Label="@L["Destination"]" Style="min-width: 14rem" />
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => AddRouteAsync(w.Id)">
                                    @L["AddRoute"]
                                </MudButton>
                            </MudStack>

                            <MudText Typo="Typo.subtitle1">@L["RecentScans"]</MudText>
                            @{
                                var recent = GetRecentForWatch(w.Id);
                            }
                            @if (recent.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["NoScans"]</MudText>
                            }
                            else
                            {
                                <MudSimpleTable Dense="true" Hover="true" Style="background: transparent">
                                    <thead>
                                        <tr>
                                            <th>@L["Status"]</th>
                                            <th>@L["QueuedAt"]</th>
                                            <th>@L["New"]</th>
                                            <th>@L["PriceChanges"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in recent)
                                        {
                                            <tr>
                                                <td>
                                                    @FormatScanStatus(r)
                                                    @if (r.CloudflareBlocked)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">@L["CloudflareBadge"]</MudChip>
                                                    }
                                                </td>
                                                <td>@r.QueuedAt.ToLocalTime().ToString("g")</td>
                                                <td>@r.NewCount</td>
                                                <td>@r.PriceChangeCount</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                            }
                        </MudStack>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</MudStack>

@code {
    private IReadOnlyList<WatchResponse>? _watches;
    private CreateWatchRequest _create = NewCreateRequest();
    private readonly Dictionary<Guid, RouteForm> _routes = new();
    private readonly Dictionary<Guid, string> _editCron = new();
    private Dictionary<Guid, ScanRunResponse> _active = new();
    private IReadOnlyList<ScanRunResponse> _recentScans = [];
    private CancellationTokenSource? _pollCts;

    private string TimeZoneId => Options.Value.TimeZone;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        EnsurePolling();
    }

    private async Task ReloadAsync()
    {
        _watches = await WatchService.GetAllAsync();
        _editCron.Clear();
        if (_watches is not null)
        {
            foreach (var w in _watches)
            {
                _editCron[w.Id] = w.Cron;
                _ = GetRouteForm(w.Id);
            }
        }

        _recentScans = await ScanQuery.GetRecentAsync(50);
        await ReloadActiveAsync();
    }

    private async Task ReloadActiveAsync()
    {
        var active = await ScanQuery.GetActiveAsync();
        _active = active.ToDictionary(r => r.WatchId);
    }

    private IReadOnlyList<ScanRunResponse> GetRecentForWatch(Guid watchId) =>
        _recentScans.Where(r => r.WatchId == watchId).Take(5).ToList();

    private RouteForm GetRouteForm(Guid watchId)
    {
        if (!_routes.TryGetValue(watchId, out var form))
        {
            form = new RouteForm();
            _routes[watchId] = form;
        }

        return form;
    }

    private void EnsurePolling()
    {
        if (_pollCts is not null || _active.Count == 0)
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _pollCts = cts;
        _ = PollAsync(cts);
    }

    private async Task PollAsync(CancellationTokenSource cts)
    {
        try
        {
            while (!cts.Token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cts.Token);
                await InvokeAsync(async () =>
                {
                    await ReloadActiveAsync();
                    _recentScans = await ScanQuery.GetRecentAsync(50);
                    StateHasChanged();
                });

                if (_active.Count == 0)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // page disposed
        }
        finally
        {
            if (ReferenceEquals(_pollCts, cts))
            {
                _pollCts = null;
            }

            cts.Dispose();
        }
    }

    private static CreateWatchRequest NewCreateRequest() =>
        new()
        {
            Name = "",
            SearchUrl = "https://www.nepremicnine.net/",
            Cron = WatchCronSchedule.Every6HoursCron,
        };

    private string GetEditCron(Guid id, string fallback) =>
        _editCron.TryGetValue(id, out var cron) ? cron : fallback;

    private void OnEditCronChanged(Guid id, string cron) => _editCron[id] = cron;

    private async Task CreateAsync()
    {
        await WatchService.CreateAsync(_create);
        _create = NewCreateRequest();
        await ReloadAsync();
        Snackbar.Add(L["Save"], Severity.Success);
    }

    private async Task SaveScheduleAsync(WatchResponse watch)
    {
        var cron = GetEditCron(watch.Id, watch.Cron);
        await WatchService.UpdateAsync(
            watch.Id,
            new UpdateWatchRequest
            {
                Name = watch.Name,
                SearchUrl = watch.SearchUrl,
                Cron = cron,
                IsEnabled = watch.IsEnabled,
            }
        );
        await ReloadAsync();
        Snackbar.Add(L["SaveSchedule"], Severity.Success);
    }

    private async Task DeleteAsync(Guid id)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["Delete"],
            L["ConfirmDeleteWatch"].Value,
            yesText: L["Delete"],
            cancelText: L["Cancel"]
        );
        if (confirmed != true)
        {
            return;
        }

        await WatchService.DeleteAsync(id);
        _routes.Remove(id);
        await ReloadAsync();
    }

    private async Task RunAsync(Guid id)
    {
        await Orchestrator.EnqueueAsync(id, force: true);
        await ReloadActiveAsync();
        EnsurePolling();
    }

    private async Task AddRouteAsync(Guid watchId)
    {
        var route = GetRouteForm(watchId);
        await WatchService.AddRouteAsync(watchId, new CreateNotificationRouteRequest
        {
            Channel = route.Channel,
            Destination = route.Destination,
            Triggers = NotificationTrigger.NewListing | NotificationTrigger.PriceDecreased,
        });
        _routes[watchId] = new RouteForm();
        await ReloadAsync();
    }

    private async Task DeleteRouteAsync(Guid watchId, Guid routeId)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            L["Delete"],
            L["ConfirmDeleteRoute"].Value,
            yesText: L["Delete"],
            cancelText: L["Cancel"]
        );
        if (confirmed != true)
        {
            return;
        }

        await WatchService.DeleteRouteAsync(watchId, routeId);
        await ReloadAsync();
    }

    private string FormatActiveStatus(ScanRunResponse run)
    {
        var label = run.Status switch
        {
            ScanRunStatus.Queued => L["ScanStatusQueued"],
            ScanRunStatus.Running => L["ScanStatusRunning"],
            _ => run.Status.ToString(),
        };
        var elapsed = ScanRunProgress.FormatElapsed(
            ScanRunProgress.GetElapsed(
                run.Status,
                run.QueuedAt,
                run.StartedAt,
                DateTimeOffset.UtcNow
            )
        );
        return string.Format(L["ScanStatusWithElapsed"], label, elapsed);
    }

    private string FormatScanStatus(ScanRunResponse run)
    {
        var label = run.Status switch
        {
            ScanRunStatus.Queued => L["ScanStatusQueued"],
            ScanRunStatus.Running => L["ScanStatusRunning"],
            ScanRunStatus.Baseline => L["ScanStatusBaseline"],
            ScanRunStatus.Succeeded => L["ScanStatusSucceeded"],
            ScanRunStatus.Failed => L["ScanStatusFailed"],
            _ => run.Status.ToString(),
        };
        if (!ScanRunProgress.IsActive(run.Status))
        {
            return label;
        }

        return FormatActiveStatus(run);
    }

    private static bool IsCloudflareCoolingDown(WatchResponse watch) =>
        watch.CloudflareBlockedUntil is { } until && until > DateTimeOffset.UtcNow;

    private string SummarizeSchedule(string cron)
    {
        var model = WatchCronSchedule.Parse(cron);
        return model.Mode switch
        {
            WatchCronMode.EveryHour => L["ScheduleEveryHour"],
            WatchCronMode.Every6Hours => L["ScheduleEvery6Hours"],
            WatchCronMode.Every12Hours => L["ScheduleEvery12Hours"],
            WatchCronMode.Weekly => FormatWeekly(model),
            WatchCronMode.Custom => string.Format(L["ScheduleCustom"], model.CustomCron),
            _ => cron,
        };
    }

    private string FormatWeekly(WatchCronModel model)
    {
        var days = string.Join(
            ", ",
            model.Days.Select(d =>
                d switch
                {
                    DayOfWeek.Sunday => L["DaySunday"].Value,
                    DayOfWeek.Monday => L["DayMonday"].Value,
                    DayOfWeek.Tuesday => L["DayTuesday"].Value,
                    DayOfWeek.Wednesday => L["DayWednesday"].Value,
                    DayOfWeek.Thursday => L["DayThursday"].Value,
                    DayOfWeek.Friday => L["DayFriday"].Value,
                    DayOfWeek.Saturday => L["DaySaturday"].Value,
                    _ => d.ToString(),
                }
            )
        );
        return $"{days} {model.Time:HH:mm}";
    }

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is { } cts)
        {
            await cts.CancelAsync();
        }
    }

    private sealed class RouteForm
    {
        public NotificationChannel Channel { get; set; } = NotificationChannel.Discord;
        public string Destination { get; set; } = "";
    }
}
