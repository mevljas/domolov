@page "/scans"
@rendermode InteractiveServer
@using Domolov.Application.Contracts
@using Domolov.Application.Services
@using Domolov.Domain.Enums
@using Domolov.Domain.Services
@implements IAsyncDisposable
@inject IScanRunQueryService ScanQuery
@inject IStringLocalizer<SharedResources> L
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@L["NavScans"]</PageTitle>

<MudStack Spacing="4">
    <MudText Typo="Typo.h1">@L["NavScans"]</MudText>

    @if (_runs is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_runs.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@L["NoScans"]</MudAlert>
    }
    else
    {
        <MudTable Items="_runs" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="domolov-feed-enter">
            <HeaderContent>
                <MudTh>@L["Watch"]</MudTh>
                <MudTh>@L["Status"]</MudTh>
                <MudTh>@L["QueuedAt"]</MudTh>
                <MudTh>@L["New"]</MudTh>
                <MudTh>@L["PriceChanges"]</MudTh>
                <MudTh>@L["Error"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Watch"]">@context.WatchName</MudTd>
                <MudTd DataLabel="@L["Status"]">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@FormatStatus(context)</MudChip>
                        @if (context.CloudflareBlocked)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@L["CloudflareBadge"]</MudChip>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="@L["QueuedAt"]">@context.QueuedAt.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="@L["New"]">@context.NewCount</MudTd>
                <MudTd DataLabel="@L["PriceChanges"]">@context.PriceChangeCount</MudTd>
                <MudTd DataLabel="@L["Error"]">@(context.ErrorSummary ?? context.NotifyErrorSummary)</MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudStack>

@code {
    private IReadOnlyList<ScanRunResponse>? _runs;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        EnsurePolling();
    }

    private async Task ReloadAsync()
    {
        _runs = await ScanQuery.GetRecentAsync();
    }

    private void EnsurePolling()
    {
        if (_pollCts is not null || !HasActive())
        {
            return;
        }

        var cts = new CancellationTokenSource();
        _pollCts = cts;
        _ = PollAsync(cts);
    }

    private async Task PollAsync(CancellationTokenSource cts)
    {
        try
        {
            while (!cts.Token.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cts.Token);
                await InvokeAsync(async () =>
                {
                    await ReloadAsync();
                    StateHasChanged();
                });

                if (!HasActive())
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // page disposed
        }
        finally
        {
            if (ReferenceEquals(_pollCts, cts))
            {
                _pollCts = null;
            }

            cts.Dispose();
        }
    }

    private bool HasActive() =>
        _runs?.Any(r => ScanRunProgress.IsActive(r.Status)) == true;

    private string FormatStatus(ScanRunResponse run)
    {
        var label = StatusLabel(run.Status);
        if (!ScanRunProgress.IsActive(run.Status))
        {
            return label;
        }

        var elapsed = ScanRunProgress.FormatElapsed(
            ScanRunProgress.GetElapsed(
                run.Status,
                run.QueuedAt,
                run.StartedAt,
                DateTimeOffset.UtcNow
            )
        );
        return string.Format(L["ScanStatusWithElapsed"], label, elapsed);
    }

    private string StatusLabel(ScanRunStatus status) =>
        status switch
        {
            ScanRunStatus.Queued => L["ScanStatusQueued"],
            ScanRunStatus.Running => L["ScanStatusRunning"],
            ScanRunStatus.Baseline => L["ScanStatusBaseline"],
            ScanRunStatus.Succeeded => L["ScanStatusSucceeded"],
            ScanRunStatus.Failed => L["ScanStatusFailed"],
            _ => status.ToString(),
        };

    private static Color StatusColor(ScanRunStatus status) =>
        status switch
        {
            ScanRunStatus.Succeeded => Color.Success,
            ScanRunStatus.Failed => Color.Error,
            ScanRunStatus.Running => Color.Info,
            ScanRunStatus.Queued => Color.Default,
            ScanRunStatus.Baseline => Color.Secondary,
            _ => Color.Default,
        };

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is { } cts)
        {
            await cts.CancelAsync();
        }
    }
}
