@using Domolov
@using Microsoft.AspNetCore.Components.Authorization
@inject IStringLocalizer<SharedResources> L

<div class="domolov-nav">
    <div class="domolov-nav__brand d-none d-md-flex">
        <MudText Typo="Typo.h5" Class="domolov-brand">@L["AppName"]</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["HomeIntro"]</MudText>
    </div>

    <MudNavMenu Class="domolov-nav__links" Bordered="false">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Home">@L["NavHome"]</MudNavLink>
        <MudNavLink Href="watches" Icon="@Icons.Material.Outlined.TravelExplore">@L["NavWatches"]</MudNavLink>
        <MudNavLink Href="listings" Icon="@Icons.Material.Outlined.GridView">@L["NavListings"]</MudNavLink>
        <MudNavLink Href="scans" Icon="@Icons.Material.Outlined.History">@L["NavScans"]</MudNavLink>
        <MudNavLink Href="settings" Icon="@Icons.Material.Outlined.Settings">@L["NavSettings"]</MudNavLink>
    </MudNavMenu>

    <div class="domolov-nav__auth">
        <AuthorizeView>
            <Authorized>
                <form method="post" action="/auth/logout" data-enhance="false">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Logout"
                               Class="nav-link"
                               FullWidth="true">
                        @L["Logout"]
                    </MudButton>
                </form>
            </Authorized>
            <NotAuthorized>
                <MudNavLink Href="login" Icon="@Icons.Material.Outlined.Login">@L["Login"]</MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
